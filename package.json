{
  "name": "birrapp",
  "version": "1.0.0",
  "description": "Mapa colaborativo de bares con el precio de la cerveza y su tapa",
  "scripts": {
    "dev": "vite",
    "dev:local": "VITE_EMULATORS=1 vite",
    "emulators": "firebase emulators:start --only auth,firestore --project demo-birrapp",
    "build": "vite build",
    "test": "firebase emulators:exec --only firestore --project demo-birrapp \"node --test test/rules.test.js\"",
    "deploy": "npm run build && firebase deploy"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JaimeFerrer/Birrapp.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/JaimeFerrer/Birrapp/issues"
  },
  "homepage": "https://github.com/JaimeFerrer/Birrapp#readme",
  "dependencies": {
    "firebase": "^12.19.0",
    "leaflet": "^1.9.4"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "firebase-tools": "^15.33.0",
    "vite": "^8.3.4"
  }
}
