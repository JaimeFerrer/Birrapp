rules_version = '2';

// Reglas de seguridad de Birrapp.
// - Cualquiera puede ver los bares, sus precios y los nombres de usuario.
// - Solo los usuarios con sesión pueden añadir bares y precios, siempre a su
//   nombre, y nadie puede editar ni borrar lo que ya está guardado.
// - El resumen de cada bar (último precio, nº de opiniones, suma de precios)
//   solo puede cambiar junto con un precio nuevo que cuadre con él.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function usernameOf(userId) {
      return get(/databases/$(database)/documents/users/$(userId)).data.username;
    }

    function validPrice(price) {
      return price is number && price > 0 && price <= 100;
    }

    // Si ponen tapa, hay que valorarla de 1 a 5 estrellas.
    function validTapa(d) {
      return d.hasTapa is bool
        && (d.hasTapa
          ? ((d.tapaType == null || (d.tapaType is string && d.tapaType.size() <= 100))
            && d.tapaRating is int && d.tapaRating >= 1 && d.tapaRating <= 5)
          : (d.tapaType == null && d.tapaRating == null));
    }

    // Puntos y nº de valoraciones que aporta un precio a la media de la tapa
    // (los precios anteriores a las valoraciones no tienen `tapaRating`).
    function ratingOf(report) {
      return report.get('tapaRating', null) == null ? 0 : report.tapaRating;
    }

    function ratedOf(report) {
      return report.get('tapaRating', null) == null ? 0 : 1;
    }

    // El precio guardado en el bar coincide con el del reporte que lo acompaña.
    function matchesReport(bar, report) {
      return report.price == bar.price
        && report.hasTapa == bar.hasTapa
        && report.tapaType == bar.tapaType;
    }

    function validUsername(name) {
      return name is string && name.matches('^[A-Za-z0-9_.-]{3,30}$');
    }

    match /users/{userId} {
      allow read: if true;
      allow create: if signedIn() && request.auth.uid == userId
        && request.resource.data.keys().hasOnly(['username', 'createdAt'])
        && validUsername(request.resource.data.username)
        && request.resource.data.createdAt == request.time
        && getAfter(/databases/$(database)/documents/usernames/$(request.resource.data.username.lower())).data.uid == userId;
      // Cambio de nombre: el nombre nuevo queda reservado a tu nombre y el
      // antiguo se libera en la misma operación.
      allow update: if signedIn() && request.auth.uid == userId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['username'])
        && validUsername(request.resource.data.username)
        && getAfter(/databases/$(database)/documents/usernames/$(request.resource.data.username.lower())).data.uid == userId
        && (resource.data.username.lower() == request.resource.data.username.lower()
          || !existsAfter(/databases/$(database)/documents/usernames/$(resource.data.username.lower())));
      allow delete: if false;
    }

    // Reserva de nombres para que no haya dos usuarios con el mismo.
    match /usernames/{name} {
      allow read: if true;
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['uid'])
        && request.resource.data.uid == request.auth.uid
        && getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.username.lower() == name;
      // Solo se libera tu nombre antiguo al cambiarlo por otro.
      allow delete: if signedIn()
        && resource.data.uid == request.auth.uid
        && getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.username.lower() != name;
      allow update: if false;
    }

    match /bars/{barId} {
      allow read: if true;
      allow create: if signedIn() && validNewBar();
      allow update: if signedIn() && (validReportAdded() || validReportRemoved());
      // Solo quien creó el bar puede borrarlo (la app borra también sus
      // precios y fotos en la misma operación).
      allow delete: if signedIn() && resource.data.createdBy == request.auth.uid;

      function barPath() {
        return /databases/$(database)/documents/bars/$(barId);
      }

      function reportPath(id) {
        return /databases/$(database)/documents/bars/$(barId)/reports/$(id);
      }

      // Al borrar el bar, sus precios y fotos se pueden borrar con él. Si
      // quedara alguno suelto de un bar que ya no existe, se puede limpiar.
      function barBeingDeleted() {
        return signedIn() && !existsAfter(barPath())
          && (!exists(barPath()) || get(barPath()).data.createdBy == request.auth.uid);
      }

      function validNewBar() {
        let d = request.resource.data;
        let report = getAfter(reportPath(d.lastReportId)).data;
        return d.keys().hasOnly(['name', 'address', 'lat', 'lng', 'createdBy', 'createdByName', 'createdAt',
            'price', 'hasTapa', 'tapaType', 'priceUpdatedAt', 'reportCount', 'priceSum', 'lastReportId',
            'ratingSum', 'ratingCount'])
          && d.name is string && d.name.size() > 0 && d.name.size() <= 100
          && (d.address == null || (d.address is string && d.address.size() <= 200))
          && d.lat is number && d.lat >= -90 && d.lat <= 90
          && d.lng is number && d.lng >= -180 && d.lng <= 180
          && d.createdBy == request.auth.uid
          && d.createdByName == usernameOf(request.auth.uid)
          && d.createdAt == request.time
          && d.priceUpdatedAt == request.time
          && d.reportCount == 1
          && d.priceSum == d.price
          && d.ratingSum == ratingOf(report)
          && d.ratingCount == ratedOf(report)
          && report.userId == request.auth.uid
          && matchesReport(d, report);
      }

      // Precio nuevo: el resumen pasa a ser el de ese precio.
      function validReportAdded() {
        let d = request.resource.data;
        let old = resource.data;
        let report = getAfter(reportPath(d.lastReportId)).data;
        return d.diff(old).affectedKeys()
            .hasOnly(['price', 'hasTapa', 'tapaType', 'priceUpdatedAt', 'reportCount', 'priceSum', 'lastReportId',
              'ratingSum', 'ratingCount'])
          && d.lastReportId != old.lastReportId
          && !exists(reportPath(d.lastReportId))
          && d.reportCount == old.reportCount + 1
          && d.priceSum == old.priceSum + d.price
          && d.ratingSum == old.get('ratingSum', 0) + ratingOf(report)
          && d.ratingCount == old.get('ratingCount', 0) + ratedOf(report)
          && d.priceUpdatedAt == request.time
          && report.userId == request.auth.uid
          && matchesReport(d, report);
      }

      // Precio borrado por quien lo puso (`lastDeletedReportId`): se resta del
      // resumen y, si era el último, el resumen pasa al precio anterior.
      function validReportRemoved() {
        let d = request.resource.data;
        let old = resource.data;
        let removed = get(reportPath(d.lastDeletedReportId)).data;
        let wasLatest = old.lastReportId == d.lastDeletedReportId;
        let latest = getAfter(reportPath(d.lastReportId)).data;
        return d.diff(old).affectedKeys().hasOnly(['price', 'hasTapa', 'tapaType', 'priceUpdatedAt',
            'reportCount', 'priceSum', 'lastReportId', 'lastDeletedReportId', 'ratingSum', 'ratingCount'])
          && d.lastDeletedReportId != old.get('lastDeletedReportId', null)
          && exists(reportPath(d.lastDeletedReportId))
          && !existsAfter(reportPath(d.lastDeletedReportId))
          && removed.userId == request.auth.uid
          && d.reportCount == old.reportCount - 1
          && d.reportCount >= 1
          && d.priceSum == old.priceSum - removed.price
          && d.ratingSum == old.get('ratingSum', 0) - ratingOf(removed)
          && d.ratingCount == old.get('ratingCount', 0) - ratedOf(removed)
          && (wasLatest
            ? (d.lastReportId != old.lastReportId
              && existsAfter(reportPath(d.lastReportId))
              && matchesReport(d, latest)
              && d.priceUpdatedAt == latest.createdAt)
            : (d.lastReportId == old.lastReportId
              && d.price == old.price && d.hasTapa == old.hasTapa
              && d.tapaType == old.tapaType && d.priceUpdatedAt == old.priceUpdatedAt));
      }

      // Fotos de la cerveza y de la tapa, comprimidas como JPEG en base64.
      match /photos/{photoId} {
        allow read: if true;
        allow create: if signedIn()
          && existsAfter(barPath())
          && request.resource.data.keys().hasOnly(['kind', 'data', 'userId', 'username', 'createdAt'])
          && request.resource.data.kind in ['beer', 'tapa']
          && request.resource.data.data is string
          && request.resource.data.data.size() <= 700000
          && request.resource.data.data.matches('data:image/jpeg;base64,[A-Za-z0-9+/=]+')
          && request.resource.data.userId == request.auth.uid
          && request.resource.data.username == usernameOf(request.auth.uid)
          && request.resource.data.createdAt == request.time;
        // Cada uno puede borrar sus fotos; y todas, si borra su bar.
        allow delete: if (signedIn() && resource.data.userId == request.auth.uid) || barBeingDeleted();
        allow update: if false;
      }

      match /reports/{reportId} {
        allow read: if true;
        allow create: if signedIn() && validNewReport();
        // Cada uno puede borrar sus precios (actualizando el resumen del bar a
        // la vez); y todos, si borra su bar.
        allow delete: if (signedIn() && resource.data.userId == request.auth.uid
            && getAfter(barPath()).data.lastDeletedReportId == reportId)
          || barBeingDeleted();
        allow update: if false;

        function validNewReport() {
          let d = request.resource.data;
          return d.keys().hasOnly(['userId', 'username', 'price', 'hasTapa', 'tapaType', 'tapaRating', 'createdAt'])
            && d.userId == request.auth.uid
            && d.username == usernameOf(request.auth.uid)
            && validPrice(d.price)
            && validTapa(d)
            && d.createdAt == request.time
            && getAfter(barPath()).data.lastReportId == reportId;
        }
      }
    }
  }
}
